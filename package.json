{
  "name": "minesweeper-no-guess",
  "version": "1.0.0",
  "description": "Minesweeper that is always solvable by logic - no guessing required",
  "main": "main.js",
  "author": "phanhanhngoc220-lab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "io.github.phanhanhngoc220.minesweeper",
    "productName": "Minesweeper No Guess",
    "artifactName": "Minesweeper-NoGuess-${version}.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
